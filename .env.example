# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- [1] Transcription (required) -------------------------------------------
# console.groq.com/keys
GROQ_API_KEY=
ASR_MODEL=whisper-large-v3-turbo

# Hinglish lectures: keep this as "en".
# Whisper on auto-detect will flip between Devanagari and Latin script within
# one recording; forcing "en" keeps the whole transcript in Latin script, which
# is both readable and far easier to align against an English deck.
# Use "hi" only for a genuinely Hindi-medium class.
LECTURE_LANGUAGE=en

# --- [3][4] Generation ------------------------------------------------------
# anthropic | openai | gemini | fake
# "fake" runs the whole pipeline with no keys and no cost, for testing plumbing.
LLM_PROVIDER=anthropic

# Required for openai and gemini. Optional for anthropic (defaults to claude-opus-5).
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- [4] Video lookup (optional) --------------------------------------------
# Without this, the notes carry YouTube search links instead of specific videos.
# Everything else works unchanged.
YOUTUBE_API_KEY=

# --- Audio handling ---------------------------------------------------------
MAX_CHUNK_MB=20
CHUNK_SECONDS=600
CHUNK_OVERLAP_SECONDS=10
AUDIO_BITRATE=48k

# Delete the source recording once transcribed. Less liability, less storage.
# The transcript is always kept, so regenerating notes never needs the audio.
DELETE_AUDIO_AFTER=false

# Where session folders live.
# CLASSNOTES_DATA_DIR=./data/sessions
